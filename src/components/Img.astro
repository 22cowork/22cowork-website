---
/**
 * Image with modern formats.
 *
 * Every .jpg under public/assets has an .avif and .webp sibling generated by
 * `npm run images`. The browser takes the first type it understands, so modern
 * ones get AVIF (about 60% smaller than the JPEG across this set) and anything
 * older falls back to exactly what it was served before.
 *
 * The <picture> wrapper is display:contents in the layouts' global CSS, so it
 * leaves no box behind and existing rules that target the <img> keep working.
 */
export interface Props {
  src: string;
  alt: string;
  srcset?: string;
  sizes?: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const {
  src,
  alt,
  srcset,
  sizes,
  width,
  height,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  class: className,
} = Astro.props;

const asFormat = (value: string, ext: string) => value.replace(/\.jpe?g/gi, `.${ext}`);
const candidates = srcset ?? src;
---

<picture>
  <source type="image/avif" srcset={asFormat(candidates, "avif")} sizes={sizes} />
  <source type="image/webp" srcset={asFormat(candidates, "webp")} sizes={sizes} />
  <img
    src={src}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>
