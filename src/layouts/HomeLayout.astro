    }

    // Reserve form. Native, single screen, posts into a Make.com inbound
    // webhook (no API key in the browser). The URL is public by nature —
    // anyone reading the bundle can see it — so it is guarded here by a
    // honeypot and a fill-time floor. Override with PUBLIC_LEAD_WEBHOOK.
    const LEAD_WEBHOOK =
      import.meta.env.PUBLIC_LEAD_WEBHOOK ||
      "https://hook.eu1.make.com/1a3pshrwijhoot1p7n3r67dxsj5gs5xz";

    // A human needs a few seconds to fill five fields; a script does not.
    const formShownAt = Date.now();
    const MIN_FILL_MS = 3000;
    const CONSENT_TEXT =
      "I agree to be contacted by 22cowork, including marketing communications.";


    /**
     * Fields the Meta Conversions API needs, so the same Lead can be reported
     * from the server as well as the browser. `event_id` is what lets Meta
     * deduplicate the two, so a lead is never counted twice.
     *
     * Only filled in when the visitor accepted cookies. The Conversions API
     * recovers the leads lost to ad blockers and browser restrictions — it is
     * NOT a way around a refusal. Someone who declined has told us not to
     * report them to Meta, and that has to hold on the server too.
     */
    function metaFields() {
      var consented = window.__consent && window.__consent.state() === "granted";
      if (!consented) return { meta_forward: "no" };
      var cookie = function (name) {
        var m = document.cookie.match("(^|; )" + name + "=([^;]*)");
        return m ? decodeURIComponent(m[2]) : "";
      };
      return {
        meta_forward: "yes",
        event_id:
          (crypto.randomUUID && crypto.randomUUID()) ||
          String(Date.now()) + Math.random().toString(16).slice(2),
        event_time: Math.floor(Date.now() / 1000),
        event_source_url: location.href,
        fbp: cookie("_fbp"),
        fbc: cookie("_fbc"),
      };
    }

    const leadForm = document.getElementById("lead-form");
    if (leadForm) {
      const status = document.getElementById("form-status");
      const btn = leadForm.querySelector('button[type="submit"]');
      const btnLabel = btn ? btn.textContent : "";
      const say = (msg, ok) => {
        if (!status) return;
        status.style.display = "block";
        status.style.color = ok ? "var(--ember)" : "#e0897a";
        status.textContent = msg;
      };
      const done = () => {
        leadForm.reset();
        if (btn) btn.textContent = "Reserved ✓";
        say("Thanks, we'll confirm within a day.", true);
      };
      const failed = () => {
        if (btn) { btn.disabled = false; btn.textContent = btnLabel; }
        say("Couldn't send just now. Please email team@22cowork.pt.", false);
      };

      leadForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(leadForm).entries());

        // Bots fill every field they find, including the hidden one, and they
        // submit instantly. Either tell means drop it — silently, so the bot
        // gets no signal to adapt.
        if (data.website || Date.now() - formShownAt < MIN_FILL_MS) {
          done();
          return;
        }
        delete data.website;

        data.source = "22cowork.pt homepage";
        // Proof of consent: RGPD asks what was agreed to and when.
        data.consent_at = new Date().toISOString();
        data.consent_text = CONSENT_TEXT;
        Object.assign(data, metaFields());

        if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
        if (status) status.style.display = "none";

        try {
          // mode:"cors" on purpose. The webhook answers with
          // Access-Control-Allow-Origin: *, so the status is readable and a
          // Make-side failure (scenario off, quota spent, 5xx) surfaces here
          // instead of being swallowed by an opaque no-cors response.
          const res = await fetch(LEAD_WEBHOOK, {
            method: "POST",
            mode: "cors",
            body: new URLSearchParams(data),
          });
          if (!res.ok) { failed(); return; }
          try {
            if (window.fbq) {
              fbq('track', 'Lead', { content_name: 'Homepage reservation' },
                  data.event_id ? { eventID: data.event_id } : undefined);
            }
          } catch (err) {}
          done();
        } catch (err) {
          failed();
        }
      });
    }
  </script>
  <Consent />
</body>
</html>
