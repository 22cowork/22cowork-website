---
import "../styles/fonts.css";
import "../styles/tokens.css";
import Consent from "../components/Consent.astro";
export interface Props {
  title?: string;
  description?: string;
}
import reviews from "../data/reviews.json";
const {
  title = "22cowork · Setúbal",
  description = "A coworking space in Setúbal for people who actually work. Dedicated desks, private offices and a soundproofed studio. 35 minutes from Lisboa.",
} = Astro.props;

const siteJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "22cowork",
  description:
    "A coworking space in Setúbal for people who actually work. Dedicated desks, private offices and a soundproofed studio, 35 minutes from Lisboa.",
  url: "https://www.22cowork.pt",
  logo: "https://www.22cowork.pt/favicon-22.png",
  image: "https://www.22cowork.pt/assets/deepwork.jpg",
  telephone: "+351913781095",
  email: "team@22cowork.pt",
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Estrada Nacional 10, Km 42",
    addressLocality: "Setúbal",
    postalCode: "2910-845",
    addressCountry: "PT",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: reviews.rating,
    reviewCount: String(reviews.count),
  },
  sameAs: ["https://instagram.com/22cowork"],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Preload the hero (LCP) with a mobile-sized variant -->
  <link rel="preload" as="image" type="image/avif" href="/assets/hero-mobile.avif" imagesrcset="/assets/hero-mobile.avif 800w, /assets/hero.avif 1400w" imagesizes="100vw" fetchpriority="high" />

  <!-- Analytics is loaded by <Consent />, only after the visitor accepts. -->


  <!-- Picks the reveal strategy before first paint: browsers with scroll-driven
       animations get the CSS view timeline, the rest fall back to the observer
       in the page script. Sitting here rather than in the module below means a
       failure elsewhere in that script cannot leave content stuck at opacity 0. -->
  <script is:inline>
    try {
      if (window.CSS && CSS.supports && CSS.supports("animation-timeline", "view()")) {
        document.documentElement.classList.add("vt");
      }
    } catch (e) {}
  </script>

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon-22.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon-22.png" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(siteJsonLd)} />
  <noscript>
  </noscript>
  <style is:global>

  *{box-sizing:border-box}
  html{scroll-behavior:smooth; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility}
  body{
    margin:0; background:var(--paper); color:var(--ink);
    font-family:"Inter",system-ui,sans-serif;
    font-size:clamp(15px,1.05vw,17px); line-height:1.55;
    letter-spacing:-0.005em;
    overflow-x:hidden;
  }
  ::selection{background:var(--ink); color:var(--paper)}
  a{color:inherit; text-decoration:none}
  img,video{display:block; max-width:100%}
  /* the <picture> wrappers must leave no box behind, so rules that
     target the <img> keep working unchanged */
  picture{display:contents}

  .wrap{max-width:1320px; margin:0 auto; padding-left:var(--pad); padding-right:var(--pad)}

  .mono{font-family:"IBM Plex Mono",monospace; font-size:var(--mono-md); letter-spacing:var(--track-md); text-transform:uppercase; color:var(--muted-2)}
  .label{display:inline-flex; align-items:center; gap:.6em}
  .label::before{content:""; width:16px; height:1px; background:var(--muted-2); display:inline-block}
  /* Vertical rhythm utilities on the 8px scale. Content blocks inside a
     section step through these instead of carrying ad-hoc inline margins. */
  .mt-2{margin-top:var(--space-2)}
  .mt-3{margin-top:var(--space-3)}
  .mt-4{margin-top:var(--space-4)}
  .cursor{display:none}
  @keyframes blink{50%{opacity:0}}

  .serif{font-family:"Fraunces",Georgia,serif; font-weight:340; letter-spacing:var(--track-serif); line-height:1.02}
  h1,h2,h3{font-family:"Inter",system-ui,sans-serif; font-weight:600; letter-spacing:var(--track-sans); line-height:1.06; margin:0}
  .display{font-family:"Fraunces",Georgia,serif; font-size:clamp(2.6rem,7vw,6.4rem); font-weight:340; letter-spacing:var(--track-serif)}
  .h2{font-size:clamp(1.9rem,4vw,3.5rem); font-weight:600; line-height:1.04; letter-spacing:var(--track-sans)}
  .h3{font-size:clamp(1.3rem,2vw,1.9rem); font-weight:600}
  em{font-style:italic}

  /* Fallback reveal, for browsers without scroll-driven animations.
     The observer fires while the element is still below the fold (see the
     positive bottom rootMargin), so the fade is already under way by the time
     it is on screen — that is what stops it reading as a pop-in. */
  .rise{opacity:0; transform:translateY(14px); transition:opacity .7s var(--ease-out), transform .7s var(--ease-out)}
  .rise.in{opacity:1; transform:none}
  .rise[data-d="1"]{transition-delay:.06s}
  .rise[data-d="2"]{transition-delay:.12s}
  .rise[data-d="3"]{transition-delay:.18s}

  /* Preferred reveal: tied to scroll position rather than to a trigger, so an
     element resolves gradually as it rises up the viewport and follows the
     scroll back down. Starts at .25 rather than 0 — content is never fully
     hidden, and it is already partly visible on the way in.
     `html.vt` is set from JS only when the browser supports view timelines;
     the observer above is then not registered at all. */
  @supports (animation-timeline: view()){
    html.vt .rise{
      opacity:1; transform:none; transition:none;
      animation:riseIn linear both;
      animation-timeline:view();
      animation-range:entry 5% entry 65%;
    }
    @keyframes riseIn{
      from{opacity:.25; transform:translateY(16px)}
      to{opacity:1; transform:none}
    }
  }

  @media (prefers-reduced-motion:reduce){
    .rise{opacity:1;transform:none;transition:none}
    html.vt .rise{animation:none}
    .cursor{animation:none}
  }

  header.nav{
    position:fixed; top:0; left:0; right:0; z-index:60;
    display:flex; align-items:center; justify-content:space-between;
    padding:var(--nav-y) var(--pad);
    transition:background .5s var(--ease), border-color .5s, padding .4s;
    border-bottom:1px solid transparent;
    mix-blend-mode:difference; color:#fff;
  }
  header.nav.solid{
    mix-blend-mode:normal; color:var(--ink);
    background:color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter:saturate(1.2) blur(14px);
    border-bottom:1px solid var(--line-2);
    padding-top:var(--nav-y-solid); padding-bottom:var(--nav-y-solid);
  }
  /* Wordmark. The real logo, painted through a mask rather than set as text,
     so it takes the colour of whatever it sits on: white over the hero photo,
     ink once the nav turns solid, cream on the green footer. One asset, three
     contexts, and no fourth typeface loaded for two words. */
  .brand{
    display:block; height:38px; aspect-ratio:450/389;
    background-color:currentColor;
    -webkit-mask:url("/assets/logo-22cowork-sm.png") center/contain no-repeat;
    mask:url("/assets/logo-22cowork-sm.png") center/contain no-repeat;
  }
  @media(max-width:640px){.brand{height:32px}}

  /* Visually hidden, but still read by screen readers and search engines —
     the mark carries no text of its own. */
  .vh{position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0}
  nav.links{display:flex; gap:30px; align-items:center}
  nav.links a{font-family:"IBM Plex Mono",monospace; font-size:var(--mono-sm); letter-spacing:var(--track-sm); text-transform:uppercase; opacity:.85; transition:opacity .3s}
  nav.links a:hover{opacity:1}
  .nav-cta{border:1px solid currentColor; border-radius:var(--radius); padding:9px 18px !important; opacity:1 !important; transition:background .3s,color .3s}
  header.nav.solid .nav-cta:hover{background:var(--ink); color:var(--paper)}
  header.nav:not(.solid) .nav-cta:hover{background:#fff; color:#000}
  .burger{display:none}
  @media(max-width:860px){
    nav.links{display:none}
    .burger{display:block; font-family:"IBM Plex Mono",monospace; font-size:var(--mono-sm); letter-spacing:var(--track-sm); text-transform:uppercase; border:1px solid currentColor; border-radius:var(--radius); padding:8px 15px}
  }

  .hero{position:relative; min-height:clamp(520px,80vh,760px); display:flex; align-items:flex-end; overflow:hidden; background:var(--contrast)}
  .hero .hero-img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0}
  .hero .scrim{position:absolute; inset:0; z-index:1;
    background:linear-gradient(180deg, rgba(8,7,6,.66) 0%, rgba(8,7,6,.30) 26%, rgba(8,7,6,.42) 56%, rgba(8,7,6,.90) 100%)}
  .hero-inner, .hero-top{text-shadow:0 2px 26px rgba(0,0,0,.4)}
  .hero-inner{position:relative; z-index:2; color:#F4F1EA; width:100%; padding-bottom:var(--hero-y-bottom)}
  .hero .display{max-width:36ch; margin-top:.2em; font-size:clamp(1.85rem,4.6vw,4.1rem)}
  .hero .rot-hold{display:inline-block; min-width:12.5em; text-align:left; white-space:nowrap}
  @media(max-width:640px){
    .hero{min-height:clamp(470px,76vh,640px)}
    .hero-top{padding-top:clamp(74px,15vh,96px)}
    .hero-top .mono{font-size:.6rem; letter-spacing:.1em; line-height:1.5}
    .hero .display{max-width:100%; font-size:clamp(2rem,8vw,2.6rem)}
    .hero .rot-hold{min-width:0; white-space:normal}
    .hero .sub{font-size:1rem; margin-top:1.1rem}
    .hero-actions{gap:10px; margin-top:1.6rem}
    .btn{padding:12px 18px; font-size:.7rem}
    .trust .wrap{justify-content:flex-start; gap:12px 22px; padding:var(--trust-y) var(--pad)}
    .trust .grating{width:100%}
    .trust .resv{white-space:normal; width:100%; line-height:1.5}
    .h2{font-size:clamp(1.7rem,7.5vw,2.3rem)}
    .lead{font-size:1.05rem}
    .manifesto .quote{font-size:clamp(1.9rem,8vw,2.6rem)}
    .tech .big{font-size:clamp(1.7rem,7vw,2.3rem)}
    .m-text h3{font-size:clamp(1.5rem,6.5vw,2rem)}
    .kcard{min-height:0; padding:26px 24px}
  }
  .hero .sub{max-width:46ch; margin-top:var(--space-3); font-size:clamp(1rem,1.25vw,1.18rem); color:rgba(244,241,234,.82); line-height:1.5}
  .hero-top{position:relative; z-index:2; flex:1; display:flex; align-items:flex-start; padding-top:clamp(84px,10vh,112px)}
  .hero-top .mono{color:rgba(244,241,234,.72)}
  .hero-top .mono::before{background:rgba(244,241,234,.6)}
  .hero-actions{display:flex; gap:14px; margin-top:var(--space-5); flex-wrap:wrap}
  .btn{font-family:"IBM Plex Mono",monospace; font-size:var(--mono-md); letter-spacing:var(--track-md); font-weight:500; text-transform:uppercase; padding:14px 26px; border-radius:var(--radius); border:1px solid; transition:transform .4s var(--ease), background .3s, color .3s; display:inline-flex; align-items:center; gap:.7em}
  .btn:hover{transform:translateY(-2px)}
  .btn-solid{background:#F4F1EA; color:#0B0A08; border-color:#F4F1EA}
  .btn-ghost{background:transparent; color:#F4F1EA; border-color:rgba(244,241,234,.4)}
  .btn-ghost:hover{border-color:#F4F1EA}
  .btn-ink{background:var(--ink); color:var(--paper); border-color:var(--ink)}
  .btn-ink:hover{background:var(--ember); border-color:var(--ember)}
  .btn-outline{background:transparent; color:var(--ink); border-color:var(--line)}
  .btn-outline:hover{border-color:var(--ink)}
  .scroll-cue{position:absolute; bottom:26px; right:var(--pad); z-index:3; color:rgba(244,241,234,.7); writing-mode:vertical-rl; font-family:"IBM Plex Mono",monospace; font-size:var(--mono-xs); letter-spacing:var(--track-xs); text-transform:uppercase; display:flex; align-items:center; gap:12px}
  .scroll-cue .ln{width:1px; height:46px; background:linear-gradient(rgba(244,241,234,.7),transparent); animation:drop 2.2s var(--ease) infinite}
  @keyframes drop{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

  section{position:relative}
  .band{padding-left:0; padding-right:0}

  /* Section rhythm utilities — exactly one applied to every content section */
  .sec-tight  { padding-top: var(--sec-tight);  padding-bottom: var(--sec-tight);  }
  .sec-normal { padding-top: var(--sec-normal); padding-bottom: var(--sec-normal); }
  .sec-wide   { padding-top: var(--sec-wide);   padding-bottom: var(--sec-wide);   }

  /* Single boundary rule: one hairline on top of every section in the flow.
     currentColor keeps it legible on both the light and the dark fields.
     Explicit exceptions: hero (first, full-bleed image) and footer (terminal block). */
  .flow{border-top: var(--rule)}

  .eyebrow{margin-bottom:1.3rem}
  .lead{font-size:clamp(1.15rem,1.5vw,1.35rem); line-height:1.5; color:var(--ink-soft); max-width:40ch}

  .manifesto{background:var(--paper-2)}
  .manifesto .quote{font-family:"Fraunces",serif; font-weight:340; font-size:clamp(2.1rem,5.2vw,4.6rem); line-height:1.04; letter-spacing:var(--track-serif); max-width:20ch}
  .manifesto .quote .em{font-style:italic; color:var(--ember)}
  .manifesto .foot{margin-top:var(--space-6); display:flex; gap:40px; flex-wrap:wrap; max-width:60ch; color:var(--muted-2); font-size:1rem}

  .day{background:var(--paper-2)}
  .day .head{display:flex; justify-content:space-between; align-items:flex-end; gap:20px; flex-wrap:wrap; margin-bottom:clamp(26px,4vh,52px)}
  .moment{
    display:grid; grid-template-columns: 1fr 1.05fr; gap:clamp(24px,4vw,64px);
    align-items:center; padding:clamp(20px,3vh,42px) 0; border-top:1px solid var(--line);
  }
  .moment:nth-child(even){grid-template-columns:1.05fr 1fr}
  .moment:nth-child(even) .m-text{order:2}
  .moment:nth-child(even) .m-media{order:1}
  .m-text .time{font-family:"IBM Plex Mono",monospace; font-size:var(--mono-md); letter-spacing:var(--track-md); color:var(--ember-deep); margin-bottom:1.1rem}
  .m-text h3{font-size:clamp(1.7rem,3.2vw,2.9rem); margin-bottom:.7rem}
  .m-text p{max-width:34ch; color:var(--ink-soft); font-size:1.05rem}
  .m-media{position:relative}
  .slot{position:relative; aspect-ratio:4/3.1; border-radius:var(--radius); overflow:hidden; background:
      repeating-linear-gradient(45deg,var(--paper-3),var(--paper-3) 12px,var(--paper-2) 12px,var(--paper-2) 24px);
      border:1px solid var(--line); display:flex; align-items:flex-end}
  .slot img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover}
  .slot .tag{position:relative; z-index:1; margin:14px; font-family:"IBM Plex Mono",monospace; font-size:var(--mono-xs); letter-spacing:var(--track-xs); text-transform:uppercase; color:var(--muted-2); background:color-mix(in srgb,var(--paper) 80%,transparent); padding:6px 10px; border-radius:var(--radius); backdrop-filter:blur(4px)}
  .slot.tall{aspect-ratio:3/4}
  @media(max-width:760px){
    .moment,.moment:nth-child(even){grid-template-columns:1fr; gap:24px}
    .moment:nth-child(even) .m-text{order:1}.moment:nth-child(even) .m-media{order:2}
  }

  /* ---------- day timeline ---------- */
  .timeline{position:relative; max-width:1080px; margin:clamp(28px,5vh,52px) auto 0}
  .timeline::before{content:""; position:absolute; left:50%; top:12px; bottom:12px; width:2px; background:var(--line); transform:translateX(-50%)}
  .tl-item{display:grid; grid-template-columns:1fr auto 1fr; align-items:center; column-gap:clamp(18px,2.6vw,38px); margin:clamp(2px,0.9vh,14px) 0; position:relative}
  .tl-node{grid-column:2; display:flex; flex-direction:column; align-items:center; gap:7px; z-index:2}
  .tl-node .dot{width:12px; height:12px; border-radius:50%; background:var(--ember); box-shadow:0 0 0 5px var(--paper-2)}
  .tl-node .hr{font-family:"IBM Plex Mono",monospace; font-size:var(--mono-md); letter-spacing:var(--track-md); color:var(--ember-deep); white-space:nowrap}
  .tl-content{position:relative}
  /* compact: small image hugging the line, tight copy, the whole day fits without a marathon scroll */
  .tl-content .slot{max-width:300px; aspect-ratio:3/2}
  .tl-content h3{font-size:clamp(1.1rem,1.7vw,1.5rem); line-height:1.15; margin:.6rem 0 .25rem}
  .tl-content p{color:var(--ink-soft); font-size:.92rem; line-height:1.45; max-width:34ch}
  .tl-item.left .tl-content{grid-column:1; text-align:right}
  .tl-item.right .tl-content{grid-column:3; text-align:left}
  .tl-item.left .tl-content .slot{margin-left:auto}
  .tl-item.left .tl-content p{margin-left:auto}
  .tl-item.right .tl-content .slot{margin-right:auto}
  .tl-item.left .tl-content::after,.tl-item.right .tl-content::after{content:""; position:absolute; top:50%; transform:translateY(-50%); height:1px; background:var(--line); width:clamp(20px,3vw,44px)}
  .tl-item.left .tl-content::after{right:calc(-1 * clamp(20px,3vw,44px))}
  .tl-item.right .tl-content::after{left:calc(-1 * clamp(20px,3vw,44px))}
  @media(max-width:720px){
    .timeline{padding-left:6px}
    .timeline::before{left:7px}
    .tl-item{display:block; position:relative; margin:26px 0; padding-left:34px}
    .tl-node{flex-direction:row; gap:10px; align-items:center; margin-bottom:12px}
    .tl-node .dot{position:absolute; left:1px; top:5px; box-shadow:0 0 0 4px var(--paper-2)}
    .tl-item.left .tl-content,.tl-item.right .tl-content{grid-column:auto; text-align:left}
    .tl-item.left .tl-content p{margin-left:0}
    .tl-content::after{display:none}
  }

  /* tally lead form on the dark reserve section */
  .tally-card{background:var(--paper); border-radius:10px; padding:10px 18px; box-shadow:0 30px 70px -50px rgba(0,0,0,.6)}
  .tally-card iframe{display:block; width:100%; border:0}

  .kinds{background:var(--paper); border-top:1px solid var(--line-2)}
  .kgrid{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; margin-top:clamp(26px,4vh,44px)}
  .kcard{background:var(--paper); padding:clamp(28px,3vw,44px); min-height:340px; display:flex; flex-direction:column; justify-content:space-between; transition:background .5s var(--ease)}
  .kcard:hover{background:var(--paper-2)}
  .kcard .n{font-family:"IBM Plex Mono",monospace; font-size:var(--mono-md); letter-spacing:var(--track-md); color:var(--ember-deep)}
  .kcard h3{font-size:clamp(1.4rem,2vw,1.9rem); margin:1.6rem 0 .8rem}
  .kcard p{color:var(--ink-soft); font-size:1rem; max-width:30ch}
  @media(max-width:820px){.kgrid{grid-template-columns:1fr}}

  /* compact day rail (timeline) */
  .day-head{max-width:640px; margin:0 auto var(--space-9); text-align:center}
  .day-head .label{justify-content:center; color:var(--ember-deep); margin-bottom:1rem}
  .day-head .label::before{background:var(--ember-deep)}
  .day-head .lead{color:var(--ink-soft); margin-top:.9rem}
  .dayrail-wrap{position:relative; margin-top:var(--space-10)}
  /* The day rule. A hairline across the rail with a tick hanging over each
     stop, drawn left to right on arrival. Replaces a decorative vine whose 17
     hand-placed leaves belonged to no other part of the site; this reuses the
     hairline grammar of the spec sheet, and says what the section says: five
     moments on one day.

     Drawn in CSS rather than as an SVG so the ticks are positioned off the
     same grid as the photographs and stay centred on them at every width. */
  .dayrail-wrap::before{
    content:""; position:absolute; left:0; right:0; top:30px; height:1px;
    background:var(--ember); opacity:.28;
    transform:scaleX(0); transform-origin:left;
    animation:ruleDraw 1.4s var(--ease) .2s forwards;
  }
  .stop::before{
    content:""; position:absolute; top:-30px; left:calc(clamp(112px,10vw,156px) / 2);
    width:1px; height:12px; background:var(--ember); opacity:0;
    animation:tickIn .4s ease forwards;
  }
  .stop:nth-child(2)::before{animation-delay:.55s}
  .stop:nth-child(3)::before{animation-delay:.75s}
  .stop:nth-child(4)::before{animation-delay:.95s}
  .stop:nth-child(5)::before{animation-delay:1.15s}
  .stop:nth-child(1)::before{animation-delay:.35s}
  @keyframes ruleDraw{to{transform:scaleX(1)}}
  @keyframes tickIn{to{opacity:.5}}
  .dayrail{list-style:none; margin:0; padding:60px 0 0; display:grid; grid-template-columns:repeat(5,1fr); gap:clamp(16px,2vw,30px); position:relative; z-index:1}
  .stop{display:flex; flex-direction:column; position:relative}
  .stop .thumb{display:block; width:clamp(112px,10vw,156px); height:clamp(112px,10vw,156px); border-radius:50%; overflow:hidden; border:4px solid var(--paper); box-shadow:0 18px 40px -18px rgba(23,21,17,.55); margin-bottom:20px}
  .stop .thumb img{width:100%; height:100%; object-fit:cover}
  .stop .t{font-family:"IBM Plex Mono",monospace; font-size:var(--mono-md); letter-spacing:var(--track-md); color:var(--ember-deep); display:block; margin-bottom:.45rem}
  .stop h3{font-family:"Inter",system-ui,sans-serif; font-weight:600; font-size:clamp(1.05rem,1.5vw,1.35rem); line-height:1.14; margin:0 0 .35rem}
  .stop p{color:var(--ink-soft); font-size:.9rem; line-height:1.45; margin:0}
  @media(prefers-reduced-motion:reduce){.dayrail-wrap::before{animation:none;transform:none}.stop::before{animation:none;opacity:.5}}
  @media(max-width:820px){
