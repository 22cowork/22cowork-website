---
import Img from "../components/Img.astro";
import HomeLayout from "../layouts/HomeLayout.astro";
import reviews from "../data/reviews.json";
const maps = "https://www.google.com/maps/search/?api=1&query=22cowork&query_place_id=ChIJibrR-YpDGQ0R2UrFT6Fufsk";
---

<HomeLayout>
  <!-- NAV -->
  <header class="nav" id="nav">
    <a href="#top" class="brand"><span class="vh">22cowork</span></a>
    <nav class="links">
      <a href="#spaces">Spaces</a>
      <a href="#work">A day here</a>
      <a href="#spec">Building</a>
      <a href="/blog">Journal</a>
      <a href="#reserve" class="nav-cta">Reserve</a>
    </nav>
    <a href="#reserve" class="burger">Reserve</a>
  </header>

  <!-- HERO -->
  <section class="hero" id="top">
    <Img src="/assets/hero.jpg" srcset="/assets/hero-mobile.jpg 800w, /assets/hero.jpg 1400w" sizes="100vw" alt="Inside 22cowork, Setúbal" width="1400" height="933" loading="eager" decoding="async" fetchpriority="high" class="hero-img" />
    <div class="scrim"></div>

    <div class="hero-inner wrap">
      <h1 class="display">A coworking space for<br />people who <span class="rot-hold"><em id="rot" class="rot">ship, not sit.</em><span class="cursor"></span></span></h1>
      <p class="sub">Dedicated desks and private offices, and a soundproofed studio. In Setúbal, 35 minutes from Lisboa.</p>
      <div class="hero-actions">
        <a href="#reserve" class="btn btn-gold">Reserve your space →</a>
        <a href="#tour" class="btn btn-ghost">Take the tour</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAND -->
  <div class="trust flow">
    <div class="wrap">
      <a class="grating" href={maps} target="_blank" rel="noopener">
        <span class="stars">★★★★★</span>
        <span class="gr-txt"><b>{reviews.rating}</b> · {reviews.count} Google reviews</span>
      </a>
      <div class="stat"><b>35 min</b><span>from Lisboa</span></div>
      <div class="stat"><b>24/7</b><span>keycard access</span></div>
      <div class="stat"><b>10GB</b><span>fibre + WiFi 7</span></div>
      <div class="stat"><b>Parking</b><span>private, underground</span></div>
    </div>
  </div>

  <!-- CHOOSE YOUR SPACE -->
  <section class="band spaces flow sec-normal" id="spaces">
    <div class="wrap">
      <div class="spaces-head">
        <div class="sh-text">
          <h2 class="h2 rise">Choose your space.</h2>
          <p class="lead rise" data-d="1">Five ways to work here, from a desk for the day to your own office. Reserve the one that fits and we'll confirm within a day.</p>
        </div>
        <div class="sh-cta rise" data-d="2"><a href="#reserve" class="btn btn-gold">Reserve your space →</a></div>
      </div>

      <!-- The two most-taken options, with the photographs. -->
      <div class="sp-grid">
        <a href="#reserve" class="sp-card rise">
          <div class="sp-media"><span class="sp-badge">Most popular</span><Img src="/assets/deepwork.jpg" srcset="/assets/deepwork-800.jpg 800w, /assets/deepwork.jpg 1400w" sizes="(max-width:680px) 92vw, 45vw" alt="Dedicated desk at 22cowork" width="1400" height="1050" loading="lazy" decoding="async" /></div>
          <div class="sp-body">
            <h3>Dedicated Desk</h3>
            <p>Your own wood desk and ergonomic chair, same spot every day. The default for founders here full time.</p>
            <span class="sp-go">Reserve a desk →</span>
          </div>
        </a>

        <a href="#reserve" class="sp-card rise" data-d="1">
          <div class="sp-media"><span class="sp-badge">Opening Sept 2026</span><Img src="/assets/meeting.jpg" srcset="/assets/meeting-800.jpg 800w, /assets/meeting.jpg 1400w" sizes="(max-width:680px) 92vw, 45vw" alt="Private office at 22cowork" width="1400" height="788" loading="lazy" decoding="async" /></div>
          <div class="sp-body">
            <h3>Private Office</h3>
            <p>Natural light, your team, your layout, a door that closes. In presale now, opening September 2026.</p>
            <span class="sp-go">Reserve an office →</span>
          </div>
        </a>
      </div>

      <!-- The other three, as a light rail. Same row language as the spec
           sheet further down, so it reads as part of the same system rather
           than three more photo cards competing with the two above. -->
      <ul class="sp-list">
        <li class="rise">
          <a href="#reserve">
            <span class="pl-name">Hot Desk</span>
            <span class="pl-desc">Any open desk, any day. For remote workers and freelancers who want flexibility.</span>
            <span class="pl-go">Reserve →</span>
          </a>
        </li>
        <li class="rise" data-d="1">
          <a href="#reserve">
            <span class="pl-name">Meeting &amp; Studio</span>
            <span class="pl-desc">A closed room for client calls, plus a podcast &amp; content studio.</span>
            <span class="pl-go">Book by the hour →</span>
          </a>
        </li>
        <li class="rise" data-d="2">
          <a href="#reserve">
            <span class="pl-name">Business Address</span>
            <span class="pl-desc">A real Setúbal business address with mail handling, desk or no desk.</span>
            <span class="pl-go">Reserve →</span>
          </a>
        </li>
      </ul>

      <div class="sh-video rise" id="tour">
        <div class="video-frame" id="tour-video" data-yt="htTdP9zs7pM">
          <button class="vplay" type="button" aria-label="Play the 22cowork tour">
            <img loading="lazy" decoding="async" width="1280" height="720" class="vthumb" src="https://i.ytimg.com/vi/htTdP9zs7pM/hqdefault.jpg" alt="22cowork office tour" />
            <span class="vbtn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg></span>
          </button>
        </div>
        <div class="mt-2"><a href="https://www.youtube.com/watch?v=htTdP9zs7pM" target="_blank" rel="noopener" class="mono label">Prefer YouTube? Watch the tour there ↗</a></div>
      </div>
    </div>
  </section>

  <!-- FREE DAY PASS CTA -->
  <section class="band daypass-cta flow sec-tight">
    <div class="wrap">
      <div class="dpc rise">
        <div class="dpc-text">
          <span class="mono label">Free day pass</span>
          <h2>Not sure yet? Spend a day here, on us.</h2>
          <p>No card, no commitment. A real desk, 10GB fibre and free parking for a full day. The surest way to know if it fits.</p>
        </div>
        <div class="dpc-actions">
          <a href="/day-pass" class="btn btn-gold">Claim your free day →</a>
          <a href="/nomad-guide" class="dpc-alt">Working remotely? Get our free Setúbal guide →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="band manifesto flow sec-wide" id="space">
    <div class="wrap">
      <p class="quote rise">Fancy fails. <span class="em">Simple scales.</span></p>
      <div class="foot rise" data-d="1">
        <p>No gimmicks. No beanbag theatre. A solid room, a fast connection, and people who are actually working.</p>
      </div>
    </div>
  </section>

  <!-- SPEC SHEET, what's in the building -->
  <section class="band spec flow sec-normal" id="spec">
    <div class="wrap">
      <h2 class="h2 rise">What's actually<br />in the building.</h2>
      <div class="sheet">
        <div class="row rise"><span class="k">Net</span><span class="v">10GB fibre backbone, WiFi 7 throughout</span><span class="m">//</span></div>
        <div class="row rise"><span class="k">Access</span><span class="v">24 hour keycard entry</span><span class="m">//</span></div>
        <div class="row rise"><span class="k">Studio</span><span class="v">Soundproofed podcast &amp; content room</span><span class="m">//</span></div>
        <div class="row rise"><span class="k">Fitness</span><span class="v">Gym downstairs, Fitness Up</span><span class="m">//</span></div>
        <div class="row rise"><span class="k">Parking</span><span class="v">Private, underground</span><span class="m">//</span></div>
        <div class="row rise"><span class="k">Post</span><span class="v">Business address + mail handling</span><span class="m">//</span></div>
        <div class="row rise"><span class="k">Coffee</span><span class="v">Included, always</span><span class="m">//</span></div>
      </div>
    </div>
  </section>

  <!-- A DAY HERE, COMPACT DAY RAIL -->
  <section class="band day flow sec-normal" id="work">
    <div class="wrap">
      <div class="day-head rise">
        <span class="mono label">A day here</span>
        <h2 class="h2">One good day, on repeat.</h2>
        <p class="lead">Park underground at 08:00, gym downstairs by 17:45. The whole day handled, in one building.</p>
      </div>
      <div class="dayrail-wrap rise" data-d="1">
        <svg class="vine" viewBox="0 0 1200 60" fill="none" preserveAspectRatio="none" aria-hidden="true">
          <path class="stem" d="M6,32 C150,12 250,50 400,32 C540,14 650,50 800,32 C950,14 1060,50 1194,32" />
          <path class="tendril" d="M8,32 c-6,-4 -4,-12 3,-12 c5,0 6,5 3,8" />
          <path class="tendril" d="M1192,32 c6,-4 4,-12 -3,-12 c-5,0 -6,5 -3,8" />
          <g class="leaves">
            <path class="lf"   transform="translate(88 22) rotate(-38) scale(.95)" style="animation-delay:.8s"  d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf a" transform="translate(150 12) rotate(-28) scale(.75)" style="animation-delay:.95s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf a" transform="translate(215 40) rotate(140) scale(.7)"  style="animation-delay:1.05s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf"   transform="translate(252 48) rotate(150) scale(.92)" style="animation-delay:1.15s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf a" transform="translate(330 40) rotate(136) scale(.72)" style="animation-delay:1.3s"  d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf"   transform="translate(400 30) rotate(-26) scale(1)"   style="animation-delay:1.45s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf a" transform="translate(470 20) rotate(-44) scale(.8)"  style="animation-delay:1.58s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf"   transform="translate(540 14) rotate(-32) scale(.9)"  style="animation-delay:1.7s"  d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf a" transform="translate(612 40) rotate(140) scale(.72)" style="animation-delay:1.85s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf"   transform="translate(652 48) rotate(150) scale(.92)" style="animation-delay:1.95s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf a" transform="translate(730 40) rotate(134) scale(.74)" style="animation-delay:2.1s"  d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf"   transform="translate(800 30) rotate(-28) scale(1)"   style="animation-delay:2.2s"  d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf a" transform="translate(872 18) rotate(-46) scale(.82)" style="animation-delay:2.33s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf"   transform="translate(950 14) rotate(-32) scale(.9)"  style="animation-delay:2.45s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf a" transform="translate(1022 40) rotate(140) scale(.72)" style="animation-delay:2.6s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf"   transform="translate(1062 48) rotate(150) scale(.9)" style="animation-delay:2.7s"  d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
            <path class="lf"   transform="translate(1140 26) rotate(-30) scale(.95)" style="animation-delay:2.85s" d="M0,0 C5,-3 8,-8 4,-15 C1.5,-19 -1.5,-19 -4,-15 C-8,-8 -5,-3 0,0 Z"/>
          </g>
        </svg>
        <ol class="dayrail">
          <li class="stop"><span class="thumb"><Img src="/assets/parking.jpg" alt="Underground parking at 22cowork" loading="lazy" decoding="async" /></span><div class="s-body"><span class="t">08:00</span><h3>Park underground</h3><p>Your spot, every day. No circling, no meter.</p></div></li>
          <li class="stop"><span class="thumb"><Img src="/assets/coffee.jpg" alt="Coffee at 22cowork" loading="lazy" decoding="async" /></span><div class="s-body"><span class="t">08:20</span><h3>First coffee</h3><p>The good machine, not the sad pod. Always on.</p></div></li>
          <li class="stop"><span class="thumb"><Img src="/assets/deepwork-800.jpg" alt="Dedicated desk at 22cowork" loading="lazy" decoding="async" /></span><div class="s-body"><span class="t">09:00</span><h3>Deep work</h3><p>Your desk, 10GB fibre, quiet that holds.</p></div></li>
          <li class="stop"><span class="thumb"><Img src="/assets/studio-800.jpg" alt="Podcast and content studio at 22cowork" loading="lazy" decoding="async" /></span><div class="s-body"><span class="t">14:00</span><h3>Record it</h3><p>Soundproofed studio, same building.</p></div></li>
          <li class="stop"><span class="thumb"><Img src="/assets/gym.jpg" alt="Fitness Up gym in the 22cowork building" loading="lazy" decoding="async" /></span><div class="s-body"><span class="t">17:45</span><h3>Gym in the building</h3><p>Fitness Up, one floor down. Close the laptop, not the day.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- RESERVE -->
  <section class="contact flow sec-wide" id="reserve">
    <div class="wrap">
      <div class="grid">
        <div class="rise" data-d="1">
          <span class="mono label">Reserve your space</span>
          <h2 class="h2 mt-2">Claim your spot before it's taken.</h2>
          <div class="mono label mt-4"><a href={maps} target="_blank" rel="noopener">View on Google Maps ↗</a></div>
          <div class="mono label mt-2"><a href="mailto:team@22cowork.pt">team@22cowork.pt</a></div>
          <div class="mono mt-3" style="color:rgba(244,241,234,.45)">Pricing shared with your reservation. We compete on value, not tiers.</div>
        </div>
        <form class="rise" data-d="2" id="lead-form">
          <div class="f2">
            <div class="field"><label>Full name</label><input type="text" name="name" placeholder="Your name" required /></div>
            <div class="field"><label>Email</label><input type="email" name="email" placeholder="you@company.com" required /></div>
          </div>
          <div class="f2">
            <div class="field"><label>Phone</label><input type="tel" name="phone" placeholder="+351 …" required /></div>
            <div class="field"><label>Company</label><input type="text" name="company" placeholder="Optional" /></div>
          </div>
          <div class="field">
            <label>What are you after</label>
            <select name="interest" required aria-label="What are you after">
              <option value="">Choose…</option>
              <option>Dedicated Desk</option>
              <option>Private Office (Sept 2026)</option>
              <option>Hot Desk</option>
              <option>Meeting / Studio Room</option>
              <option>Business Address</option>
              <option>Just looking</option>
            </select>
          </div>
          <!-- Honeypot. Off-screen and out of the tab order, so only a script
               that fills every field it finds will touch it. -->
          <div class="hp" aria-hidden="true">
            <label for="lf-website">Website</label>
            <input id="lf-website" type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>I agree to be contacted by 22cowork, including marketing communications. See our <a href="/privacy">Privacy Policy</a>.</span>
          </label>
          <button type="submit" class="btn btn-gold" style="justify-self:start">Reserve your space →</button>
          <p id="form-status" class="mono" role="status" aria-live="polite" class="mt-2" style="display:none; color:var(--ember)"></p>
        </form>
      </div>
    </div>
  </section>

  <!-- COMMUNITY -->
  <section class="band comm flow sec-tight">
    <div class="wrap comm-grid">
      <div>
        <h2 class="h2 rise">Not a lobby<br />full of strangers.</h2>
        <p class="lead rise mt-3" data-d="1">Follow the building day to day. Who's shipped what, which desks are open, what's on this month.</p>
        <div class="rise mt-4" data-d="1"><a href="https://instagram.com/22cowork" target="_blank" rel="noopener" class="btn btn-outline">@22cowork on Instagram →</a></div>
      </div>
      <div class="ig rise" data-d="1" id="ig-feed">
        <a href="https://instagram.com/22cowork" target="_blank" rel="noopener" class="slot"><Img src="/assets/grid1.jpg" alt="Open workspace at 22cowork" width="700" height="700" loading="lazy" decoding="async" /><span class="tag">@22cowork</span></a>
        <a href="https://instagram.com/22cowork" target="_blank" rel="noopener" class="slot"><Img src="/assets/grid2.jpg" alt="Lounge at 22cowork" width="700" height="700" loading="lazy" decoding="async" /></a>
        <a href="https://instagram.com/22cowork" target="_blank" rel="noopener" class="slot"><Img src="/assets/grid3.jpg" alt="Storage and desks at 22cowork" width="700" height="700" loading="lazy" decoding="async" /></a>
        <a href="https://instagram.com/22cowork" target="_blank" rel="noopener" class="slot"><Img src="/assets/grid4.jpg" alt="Meeting and studio room at 22cowork" width="700" height="700" loading="lazy" decoding="async" /></a>
        <a href="https://instagram.com/22cowork" target="_blank" rel="noopener" class="slot"><Img src="/assets/grid5.jpg" alt="Kitchen at 22cowork" width="700" height="700" loading="lazy" decoding="async" /></a>
        <a href="https://instagram.com/22cowork" target="_blank" rel="noopener" class="slot"><Img src="/assets/grid6.jpg" alt="Content studio at 22cowork" width="700" height="700" loading="lazy" decoding="async" /></a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="foot">
    <div class="wrap">
      <div class="foot-top">
        <div>
          <div class="big-brand"><span class="vh">22cowork</span></div>
          <p class="mt-2" style="max-width:34ch; color:var(--muted-2)">A workspace for founders, creators and freelancers. Setúbal, Portugal. 35 minutes from Lisboa.</p>
          <a class="grating foot-rating" href={maps} target="_blank" rel="noopener">
            <span class="stars">★★★★★</span>
            <span class="gr-txt"><b>{reviews.rating}</b> · {reviews.count} Google reviews</span>
          </a>
          <address class="foot-addr mt-2" style="font-style:normal; color:rgba(244,241,234,.72); line-height:1.6; font-size:.92rem">
            Estrada Nacional 10, Km 42<br />2910-845 Setúbal, Portugal
          </address>
          <a class="foot-map" href={maps} target="_blank" rel="noopener" aria-label="View 22cowork on Google Maps">
            <svg width="15" height="19" viewBox="0 0 24 32" fill="none" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 8.6 12 20 12 20s12-11.4 12-20C24 5.37 18.63 0 12 0Z" fill="#8FC0A9"/>
              <circle cx="12" cy="12" r="4.4" fill="#294A3B"/>
            </svg>
            <span>View on Google Maps</span>
          </a>
        </div>
        <div>
          <h4>Space</h4>
          <a href="#spaces">Spaces</a><a href="#work">A day here</a><a href="#spec">The building</a><a href="#tour">Tour</a>
        </div>
        <div>
          <h4>Company</h4>
          <a href="/blog">Journal</a><a href="#reserve">Reserve a space</a><a href="/nomad-guide">Free nomad guide</a><a href="https://instagram.com/22cowork" target="_blank" rel="noopener">Instagram</a>
        </div>
        <div>
          <h4>Legal</h4>
          <a href="/privacy">Privacy Policy</a><a href="#" data-consent-reopen>Cookie settings</a>
        </div>
      </div>
      <div class="foot-bottom">
        <span class="mono">© 2026 22cowork · Setúbal, Portugal</span>
        <span class="mono">Built simple. Made to last.</span>
      </div>
    </div>
  </footer>
</HomeLayout>
